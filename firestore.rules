rules_version = '2';
// Modelo:
//  - catalog, installed, meta, status: los escribe solo el backend (cuenta de servicio, que se salta estas reglas); lectura pública.
//  - config/owner: el primer usuario con cuenta de Google que lo reclama es el dueño; nadie puede cambiarlo después.
//  - selection/main: lectura pública; solo la escribe el dueño.
//  - suggestions/{uid}: cada visitante escribe la suya; el dueño lee todas.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownerPath() { return /databases/$(database)/documents/config/owner; }
    function isOwner() {
      return signedIn() && exists(ownerPath()) && get(ownerPath()).data.uid == request.auth.uid;
    }
    function notAnonymous() { return request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function okName(n) { return n is string && n.size() <= 40; }

    match /catalog/{code}   { allow read: if true; allow write: if false; }
    match /installed/{code} { allow read: if true; allow write: if false; }
    match /meta/{doc}       { allow read: if true; allow write: if false; }
    match /status/{key}     { allow read: if true; allow write: if false; }

    match /config/owner {
      allow read: if true;
      allow create: if signedIn() && notAnonymous()
        && request.resource.data.keys().hasOnly(['uid', 'claimedAt'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /selection/main {
      allow read: if true;
      allow write: if isOwner()
        && request.resource.data.keys().hasOnly(['ownerName', 'picks', 'repl', 'keepOrig', 'updatedAt', 'updatedMs'])
        && okName(request.resource.data.ownerName)
        && request.resource.data.picks is map && request.resource.data.picks.size() <= 400;
    }

    match /suggestions/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'picks', 'updatedAt'])
        && okName(request.resource.data.name)
        && request.resource.data.picks is list && request.resource.data.picks.size() <= 400;
      allow delete: if signedIn() && (request.auth.uid == uid || isOwner());
    }
  }
}
